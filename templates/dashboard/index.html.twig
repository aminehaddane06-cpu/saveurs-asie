{% extends 'base.html.twig' %}

{% block title %}Tableau de Bord - Les Saveurs d'Asie{% endblock %}

{% block body %}
<!-- EN-TÊTE DASHBOARD -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1" style="color: #1E293B; letter-spacing: -0.5px;">Tableau de Bord Direction</h2>
        <p class="text-muted small mb-0">Restaurant Les Saveurs d'Asie • Tourcoing (15 Rue Saint-Jacques)</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-light text-dark border px-3 py-2 rounded-3 small">
            <i class="bi bi-calendar-event me-1 text-danger"></i> {{ "now"|date("d/m/Y") }}
        </span>
        <a href="/pos" class="btn text-white fw-semibold px-3 py-2 d-flex align-items-center gap-2" style="background-color: var(--brand-red); border-radius: 10px;">
            <i class="bi bi-calculator"></i>
            <span>Accéder à la Caisse</span>
        </a>
    </div>
</div>

<!-- 4 CARTES KPI (CHIFFRES CLÉS) -->
<div class="row g-3 mb-4">
    <!-- CA DU JOUR -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="app-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <span class="text-muted small fw-semibold">Chiffre d'Affaires (Jour)</span>
                    <h3 class="fw-bold mb-0 mt-1" style="color: var(--brand-red);">1 428,50 €</h3>
                </div>
                <div class="p-2 rounded-3 bg-danger-subtle text-danger fs-5">
                    <i class="bi bi-currency-euro"></i>
                </div>
            </div>
            <div class="small text-success fw-semibold">
                <i class="bi bi-arrow-up-right"></i> +12.4% <span class="text-muted fw-normal">vs hier</span>
            </div>
        </div>
    </div>

    <!-- COMMANDES / COUVERTS -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="app-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <span class="text-muted small fw-semibold">Commandes servies</span>
                    <h3 class="fw-bold mb-0 mt-1">46</h3>
                </div>
                <div class="p-2 rounded-3 bg-primary-subtle text-primary fs-5">
                    <i class="bi bi-receipt"></i>
                </div>
            </div>
            <div class="small text-muted">
                <span class="fw-semibold text-dark">32</span> sur place • <span class="fw-semibold text-dark">14</span> à emporter / livr.
            </div>
        </div>
    </div>

    <!-- PANIER MOYEN -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="app-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <span class="text-muted small fw-semibold">Panier Moyen</span>
                    <h3 class="fw-bold mb-0 mt-1">31,05 €</h3>
                </div>
                <div class="p-2 rounded-3 bg-success-subtle text-success fs-5">
                    <i class="bi bi-bag-check"></i>
                </div>
            </div>
            <div class="small text-success fw-semibold">
                <i class="bi bi-arrow-up-right"></i> +3.2% <span class="text-muted fw-normal">cette semaine</span>
            </div>
        </div>
    </div>

    <!-- ALERTES STOCKS -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="app-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <span class="text-muted small fw-semibold">Alertes Stock</span>
                    <h3 class="fw-bold mb-0 mt-1 text-warning-emphasis">3</h3>
                </div>
                <div class="p-2 rounded-3 bg-warning-subtle text-warning-emphasis fs-5">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
            </div>
            <div class="small">
                <a href="/admin/stocks" class="text-danger fw-semibold text-decoration-none">
                    Voir les ruptures <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- SECTION 2 : DERNIÈRES COMMANDES & TOP VENTES -->
<div class="row g-4">
    <!-- TABLEAU DES DERNIÈRES COMMANDES -->
    <div class="col-12 col-xl-8">
        <div class="app-card p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0">Commandes du service en direct</h6>
                <a href="/pos" class="small fw-semibold text-decoration-none" style="color: var(--brand-red);">Ouvrir la caisse</a>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="text-muted small">
                        <tr>
                            <th>N° Ticket</th>
                            <th>Type</th>
                            <th>Serveur</th>
                            <th>Montant</th>
                            <th>Heure</th>
                            <th>Statut</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        <tr>
                            <td class="fw-bold">#CMD-1048</td>
                            <td><span class="badge bg-light text-dark border">Sur place (Table 4)</span></td>
                            <td>Équipier Caisse</td>
                            <td class="fw-bold">48,50 €</td>
                            <td class="text-muted">12:42</td>
                            <td><span class="badge bg-success-subtle text-success rounded-pill px-2 py-1">Encaissée</span></td>
                        </tr>
                        <tr>
                            <td class="fw-bold">#CMD-1047</td>
                            <td><span class="badge bg-info-subtle text-info border">Livraison</span></td>
                            <td>Boutique en ligne</td>
                            <td class="fw-bold">36,00 €</td>
                            <td class="text-muted">12:35</td>
                            <td><span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-2 py-1">En préparation</span></td>
                        </tr>
                        <tr>
                            <td class="fw-bold">#CMD-1046</td>
                            <td><span class="badge bg-light text-dark border">À emporter</span></td>
                            <td>Équipier Caisse</td>
                            <td class="fw-bold">22,80 €</td>
                            <td class="text-muted">12:20</td>
                            <td><span class="badge bg-success-subtle text-success rounded-pill px-2 py-1">Encaissée</span></td>
                        </tr>
                        <tr>
                            <td class="fw-bold">#CMD-1045</td>
                            <td><span class="badge bg-light text-dark border">Sur place (Table 2)</span></td>
                            <td>Amine H. (Gérant)</td>
                            <td class="fw-bold">64,20 €</td>
                            <td class="text-muted">12:05</td>
                            <td><span class="badge bg-success-subtle text-success rounded-pill px-2 py-1">Encaissée</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- TOP PLATS LES PLUS COMMANDÉS -->
    <div class="col-12 col-xl-4">
        <div class="app-card p-4">
            <h6 class="fw-bold mb-3">Top Ventes du jour</h6>
            <div class="d-flex flex-column gap-3">
                <div class="d-flex align-items-center justify-content-between p-2 rounded-3 bg-light">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge rounded-circle bg-danger text-white p-2" style="width: 26px; height: 26px; display: flex; align-items: center; justify-content: center;">1</span>
                        <div>
                            <div class="fw-semibold small">Maki Saumon Avocat (x6)</div>
                            <div class="text-muted" style="font-size: 0.72rem;">Japonais</div>
                        </div>
                    </div>
                    <span class="fw-bold small text-dark">28 vendus</span>
                </div>

                <div class="d-flex align-items-center justify-content-between p-2 rounded-3 bg-light">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge rounded-circle bg-danger text-white p-2" style="width: 26px; height: 26px; display: flex; align-items: center; justify-content: center;">2</span>
                        <div>
                            <div class="fw-semibold small">Poulet Croustillant Caramel</div>
                            <div class="text-muted" style="font-size: 0.72rem;">Chinois</div>
                        </div>
                    </div>
                    <span class="fw-bold small text-dark">21 vendus</span>
                </div>

                <div class="d-flex align-items-center justify-content-between p-2 rounded-3 bg-light">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge rounded-circle bg-danger text-white p-2" style="width: 26px; height: 26px; display: flex; align-items: center; justify-content: center;">3</span>
                        <div>
                            <div class="fw-semibold small">Nems au Poulet (x4)</div>
                            <div class="text-muted" style="font-size: 0.72rem;">Entrées</div>
                        </div>
                    </div>
                    <span class="fw-bold small text-dark">19 vendus</span>
                </div>
            </div>

            <hr class="my-3 text-muted">

            <div class="d-grid gap-2">
                <a href="/admin/products" class="btn btn-outline-secondary btn-sm py-2 fw-semibold">
                    <i class="bi bi-journal-text me-1"></i> Gérer la carte complète
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}