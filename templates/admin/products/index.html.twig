{% extends 'base.html.twig' %}

{% block title %}Gestion de la Carte - Les Saveurs d'Asie{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold mb-0">Gestion de la Carte & Menus</h2>
        <p class="text-muted mb-0">Ajoutez, modifiez ou désactivez les plats proposés en caisse.</p>
    </div>
    <button class="btn bg-asian-primary text-white" data-bs-toggle="modal" data-bs-target="#modalNewProduct">
        <i class="bi bi-plus-circle me-1"></i> Ajouter un plat
    </button>
</div>

{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}
{% endfor %}

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Plat / Article</th>
                    <th>Catégorie</th>
                    <th>Prix HT</th>
                    <th>TVA</th>
                    <th>Prix TTC</th>
                    <th>Statut</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for product in products %}
                <tr>
                    <td class="fw-bold">
                        {{ product.name }}
                        {% if product.description %}
                            <div class="small text-muted fw-normal">{{ product.description }}</div>
                        {% endif %}
                    </td>
                    <td><span class="badge bg-secondary">{{ product.category.name }}</span></td>
                    <td>{{ product.priceHt }} €</td>
                    <td>{{ product.vatRate }} %</td>
                    <td class="fw-bold text-asian-primary">{{ product.priceTtc|number_format(2, ',', ' ') }} €</td>
                    <td>
                        {% if product.isActive %}
                            <span class="badge bg-success">Actif</span>
                        {% else %}
                            <span class="badge bg-danger">Indisponible</span>
                        {% endif %}
                    </td>
                    <td class="text-end">
                        <form method="post" action="{{ path('admin_product_toggle', {id: product.id}) }}" class="d-inline">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('toggle_prod_' ~ product.id) }}">
                            <button class="btn btn-sm btn-outline-secondary" title="Activer / Désactiver">
                                <i class="bi bi-arrow-repeat"></i>
                            </button>
                        </form>
                        <form method="post" action="{{ path('admin_product_delete', {id: product.id}) }}" class="d-inline" onsubmit="return confirm('Confirmer la suppression de ce plat ?');">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('delete_prod_' ~ product.id) }}">
                            <button class="btn btn-sm btn-outline-danger" title="Supprimer">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="7" class="text-center py-4 text-muted">Aucun plat enregistré sur la carte.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Ajout Plat -->
<div class="modal fade" id="modalNewProduct" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="{{ path('admin_product_new') }}">
                <div class="modal-header bg-asian-primary text-white">
                    <h5 class="modal-title fw-bold">Ajouter un nouveau plat</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_product') }}">
                    <div class="mb-3">
                        <label class="form-label">Nom du plat *</label>
                        <input type="text" name="name" class="form-control" required placeholder="Ex: Soupe Tom Yum">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Catégorie *</label>
                        <select name="category_id" class="form-select" required>
                            {% for cat in categories %}
                                <option value="{{ cat.id }}">{{ cat.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Prix HT (€) *</label>
                            <input type="number" step="0.01" name="price_ht" class="form-control" required placeholder="10.00">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Taux TVA (%)</label>
                            <select name="vat_rate" class="form-select">
                                <option value="10.00" selected>10.00 % (Restauration)</option>
                                <option value="5.50">5.50 % (Alimentaire)</option>
                                <option value="20.00">20.00 % (Alcool / Standard)</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description / Ingrédients</label>
                        <textarea name="description" class="form-control" rows="2" placeholder="Description courte..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn bg-asian-primary text-white">Enregistrer le plat</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}