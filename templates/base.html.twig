<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Les Saveurs d'Asie - Système de Gestion{% endblock %}</title>
    <!-- Bootstrap 5 CSS & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root {
            --primary-asian: #B83B26;
            --dark-asian: #1A1A1A;
            --gold-asian: #D4AF37;
        }
        .bg-asian-primary { background-color: var(--primary-asian) !important; }
        .text-asian-primary { color: var(--primary-asian) !important; }
        .navbar-asian { background-color: var(--dark-asian); }
        .nav-link.active { font-weight: bold; color: var(--gold-asian) !important; }
    </style>
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    {% if app.user %}
    <nav class="navbar navbar-expand-lg navbar-dark navbar-asian py-2 shadow-sm">
        <div class="container-fluid px-4">
            <a class="navbar-brand fw-bold text-uppercase d-flex align-items-center gap-2" href="{{ path('app_dashboard') }}">
                <span class="fs-4">🥢</span> Les Saveurs d'Asie
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
                <span class="navbar-toggler-indicator"></span>
            </button>
            <div class="collapse navbar-collapse" id="navContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_dashboard') }}"><i class="bi bi-speedometer2 me-1"></i> Tableau de bord</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/pos"><i class="bi bi-calculator me-1"></i> Caisse / Vente</a>
                    </li>
                    {% if is_granted('ROLE_ADMIN') %}
                    <li class="nav-item">
                        <a class="nav-link" href="/admin/products"><i class="bi bi-book me-1"></i> Carte & Menu</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/admin/stocks"><i class="bi bi-box-seam me-1"></i> Stocks</a>
                    </li>
                    {% endif %}
                </ul>
                <div class="d-flex align-items-center gap-3 text-white">
                    <span class="badge bg-secondary">{{ app.user.roles[0] }}</span>
                    <span>{{ app.user.firstName }} {{ app.user.lastName }}</span>
                    <a href="{{ path('app_logout') }}" class="btn btn-outline-light btn-sm"><i class="bi bi-box-arrow-right"></i> Déconnexion</a>
                </div>
            </div>
        </div>
    </nav>
    {% endif %}

    <main class="container-fluid px-4 py-4 flex-grow-1">
        {% block body %}{% endblock %}
    </main>

    <footer class="bg-white border-top py-3 text-center text-muted small mt-auto">
        Système de Gestion Interne — Les Saveurs d'Asie © 2026
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>