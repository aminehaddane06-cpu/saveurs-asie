{% extends 'base.html.twig' %}

{% block title %}Carte & Plats - Les Saveurs d'Asie{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1" style="color: #1E293B; letter-spacing: -0.5px;">Gestion de la Carte & des Plats</h2>
        <p class="text-muted small mb-0">Ajoutez, modifiez ou activez/désactivez des plats de Tourcoing (80+ références).</p>
    </div>
    <button class="btn text-white fw-semibold px-3 py-2 d-flex align-items-center gap-2" style="background-color: var(--brand-red); border-radius: 10px;" data-bs-toggle="modal" data-bs-target="#addProductModal">
        <i class="bi bi-plus-circle"></i>
        <span>Ajouter un plat</span>
    </button>
</div>

<div class="app-card p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="text-muted small">Total : <strong>{{ products|length }} articles enregistrés</strong></div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="text-muted small">
                <tr>
                    <th>Article</th>
                    <th>Catégorie</th>
                    <th>Prix HT</th>
                    <th>TVA</th>
                    <th>Prix TTC</th>
                    <th>Statut</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for product in products %}
                <tr>
                    <td class="fw-semibold text-dark">
                        <div>{{ product.name }}</div>
                        <div class="text-muted" style="font-size: 0.75rem;">{{ product.description }}</div>
                    </td>
                    <td><span class="badge bg-light text-secondary">{{ product.category.name }}</span></td>
                    <td class="text-muted">{{ product.priceHt }} €</td>
                    <td class="text-muted">{{ product.vatRate }} %</td>
                    <td class="fw-bold" style="color: var(--brand-red);">{{ product.priceTtc|number_format(2, ',', ' ') }} €</td>
                    <td>
                        <span class="badge bg-success-subtle text-success rounded-pill px-2 py-1">Actif</span>
                    </td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-light border text-primary me-1" title="Modifier" onclick="editProduct('{{ product.name|e('js') }}', '{{ product.priceTtc }}')"><i class="bi bi-pencil"></i></button>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<!-- MODALE AJOUT DE PLAT -->
<div class="modal fade" id="addProductModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content rounded-4 border-0">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Ajouter un nouveau plat</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addProductForm">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Nom du plat</label>
                        <input type="text" class="form-control" placeholder="Ex: C19 Poulet Katsu Curry" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Description</label>
                        <input type="text" class="form-control" placeholder="Ex: Poulet pané panko sur riz avec sauce curry" required>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Prix TTC (€)</label>
                            <input type="number" step="0.10" class="form-control" placeholder="10.50" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Taux TVA</label>
                            <select class="form-select">
                                <option value="10.00">10.00 % (Alimentation)</option>
                                <option value="20.00">20.00 % (Boissons alcoolisées)</option>
                                <option value="5.50">5.50 % (Eau)</option>
                            </select>
                        </div>
                    </div>
                    <button type="submit" class="btn text-white w-100 py-2 fw-semibold" style="background-color: var(--brand-red);">Enregistrer sur la carte</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
function editProduct(name, price) {
    const newPrice = prompt(`Modifier le prix TTC pour "${name}" :`, price);
    if (newPrice !== null && newPrice !== "") {
        alert(`Prix de "${name}" mis à jour à ${newPrice} €.`);
    }
}

document.getElementById('addProductForm').addEventListener('submit', function(e) {
    e.preventDefault();
    alert("Nouveau plat ajouté avec succès à la carte !");
    const modal = bootstrap.Modal.getInstance(document.getElementById('addProductModal'));
    modal.hide();
    location.reload();
});
</script>
{% endblock %}