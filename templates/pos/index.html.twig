{% extends 'base.html.twig' %}

{% block title %}Caisse POS - Les Saveurs d'Asie{% endblock %}

{% block body %}
<div class="row g-3">
    <!-- ZONE SELECTION PLATS POS -->
    <div class="col-12 col-xl-8">
        <!-- FILTRES CATEGORIES -->
        <div class="d-flex gap-2 overflow-auto pb-2 mb-3">
            <button class="btn btn-sm text-white fw-semibold rounded-pill px-3" style="background-color: var(--brand-red);" onclick="filterPosCat('all', this)">Tous</button>
            {% for cat in categories %}
                <button class="btn btn-sm btn-white bg-white border fw-semibold rounded-pill px-3 text-nowrap" onclick="filterPosCat('{{ cat.id }}', this)">{{ cat.name }}</button>
            {% endfor %}
        </div>

        <!-- GRILLE DES PLATS POS AVEC MINIATURES -->
        <div class="row g-3">
            {% for product in products %}
            <div class="col-6 col-md-4 col-lg-3 pos-product-card" data-cat="{{ product.category.id }}">
                <div class="app-card h-100 p-2 d-flex flex-column justify-content-between" role="button" onclick="addPosCart({{ product.id }}, '{{ product.name|e('js') }}', {{ product.priceTtc }})">
                    {% if product.imageUrl %}
                        <img src="{{ product.imageUrl }}" alt="{{ product.name }}" class="w-100 rounded-3 mb-2" style="height: 85px; object-fit: cover;">
                    {% else %}
                        <div class="w-100 bg-light rounded-3 mb-2 d-flex align-items-center justify-content-center text-muted fs-4" style="height: 85px;">🥢</div>
                    {% endif %}
                    <div>
                        <div class="fw-semibold text-truncate small mb-1" title="{{ product.name }}">{{ product.name }}</div>
                        <span class="fw-bold small" style="color: var(--brand-red);">{{ product.priceTtc|number_format(2, ',', ' ') }} €</span>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>

    <!-- TICKET DE CAISSE EN DIRECT -->
    <div class="col-12 col-xl-4">
        <div class="app-card p-3 sticky-top" style="top: 85px;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-receipt me-1"></i>Ticket de Caisse</h6>
                <button class="btn btn-sm btn-light border text-danger" onclick="clearPosCart()"><i class="bi bi-trash"></i> Vider</button>
            </div>

            <!-- TYPE DE COMMANDE -->
            <div class="btn-group w-100 mb-3" role="group">
                <input type="radio" class="btn-check" name="posType" id="posSurPlace" checked>
                <label class="btn btn-outline-secondary btn-sm" for="posSurPlace">Sur place</label>
                
                <input type="radio" class="btn-check" name="posType" id="posEmporter">
                <label class="btn btn-outline-secondary btn-sm" for="posEmporter">À emporter</label>
                
                <input type="radio" class="btn-check" name="posType" id="posLivraison">
                <label class="btn btn-outline-secondary btn-sm" for="posLivraison">Livraison</label>
            </div>

            <!-- ARTICLES TICKET -->
            <div id="posCartList" class="mb-3" style="max-height: 280px; overflow-y: auto;">
                <p class="text-muted small text-center py-4">Ticket vide. Cliquez sur un plat.</p>
            </div>

            <!-- TOTAL POS -->
            <div class="border-top pt-2 mb-3">
                <div class="d-flex justify-content-between fw-bold fs-5">
                    <span>Total à encaisser</span>
                    <span style="color: var(--brand-red);" id="posTotalDisplay">0,00 €</span>
                </div>
            </div>

            <!-- ENCAISSEMENT -->
            <div class="row g-2">
                <div class="col-6">
                    <button class="btn btn-success w-100 py-2 fw-semibold rounded-3" onclick="validatePosOrder('ESPECES')">
                        <i class="bi bi-cash me-1"></i> Espèces
                    </button>
                </div>
                <div class="col-6">
                    <button class="btn btn-primary w-100 py-2 fw-semibold rounded-3" onclick="validatePosOrder('CB')">
                        <i class="bi bi-credit-card me-1"></i> Carte CB
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
let posCart = [];

function filterPosCat(catId, btn) {
    document.querySelectorAll('.btn').forEach(b => {
        if (b.onclick && b.onclick.toString().includes('filterPosCat')) {
            b.classList.remove('text-white');
            b.style.backgroundColor = '';
            b.classList.add('bg-white', 'text-dark');
        }
    });
    btn.classList.add('text-white');
    btn.style.backgroundColor = 'var(--brand-red)';

    document.querySelectorAll('.pos-product-card').forEach(card => {
        if (catId === 'all' || card.dataset.cat === catId) {
            card.style.display = 'block';
        } else {
            card.style.display = 'none';
        }
    });
}

function addPosCart(id, name, price) {
    const exist = posCart.find(i => i.id === id);
    if (exist) {
        exist.quantity += 1;
    } else {
        posCart.push({ id, name, price, quantity: 1 });
    }
    renderPosCart();
}

function updatePosQty(id, delta) {
    const item = posCart.find(i => i.id === id);
    if (!item) return;
    item.quantity += delta;
    if (item.quantity <= 0) {
        posCart = posCart.filter(i => i.id !== id);
    }
    renderPosCart();
}

function clearPosCart() {
    posCart = [];
    renderPosCart();
}

function renderPosCart() {
    const box = document.getElementById('posCartList');
    if (posCart.length === 0) {
        box.innerHTML = '<p class="text-muted small text-center py-4">Ticket vide. Cliquez sur un plat.</p>';
        document.getElementById('posTotalDisplay').innerText = '0,00 €';
        return;
    }
    let total = 0;
    let html = '';
    posCart.forEach(item => {
        const line = item.price * item.quantity;
        total += line;
        html += `
            <div class="d-flex justify-content-between align-items-center mb-2 p-2 bg-light rounded-3 small">
                <div class="me-2 text-truncate">
                    <div class="fw-semibold text-truncate">${item.name}</div>
                    <div class="text-muted">${item.price.toFixed(2)} €</div>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <button class="btn btn-sm btn-white bg-white border p-0 px-2 fw-bold" onclick="updatePosQty(${item.id}, -1)">-</button>
                    <span class="fw-bold px-1">${item.quantity}</span>
                    <button class="btn btn-sm btn-white bg-white border p-0 px-2 fw-bold" onclick="updatePosQty(${item.id}, 1)">+</button>
                    <span class="fw-bold ms-2 text-end" style="min-width: 50px;">${line.toFixed(2)} €</span>
                </div>
            </div>
        `;
    });
    box.innerHTML = html;
    document.getElementById('posTotalDisplay').innerText = total.toFixed(2).replace('.', ',') + ' €';
}

function validatePosOrder(paymentMethod) {
    if (posCart.length === 0) {
        alert("Le ticket de caisse est vide.");
        return;
    }

    let type = 'SUR_PLACE';
    if (document.getElementById('posEmporter').checked) type = 'A_EMPORTER';
    if (document.getElementById('posLivraison').checked) type = 'LIVRAISON';

    fetch('{{ path('app_pos_checkout') }}', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            items: posCart,
            type: type,
            paymentMethod: paymentMethod
        })
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            alert(`✅ Commande encaissée avec succès (${paymentMethod}) !\nMontant : ${data.totalTtc}\nTicket envoyé en cuisine.`);
            clearPosCart();
        } else {
            alert("Erreur lors de l'encaissement : " + data.message);
        }
    })
    .catch(err => {
        console.error(err);
        alert("Une erreur de communication est survenue.");
    });
}
</script>
{% endblock %}
