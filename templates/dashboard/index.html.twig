{% extends 'base.html.twig' %}

{% block title %}Tableau de bord - Les Saveurs d'Asie{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold mb-0">Tableau de bord</h2>
        <p class="text-muted mb-0">Bienvenue, {{ app.user.firstName }} {{ app.user.lastName }} ({{ app.user.roles[0] }})</p>
    </div>
    <span class="badge bg-success py-2 px-3"><i class="bi bi-circle-fill me-1 small"></i> Service En Cours</span>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase">Caisse / Ventes</span>
                    <h3 class="fw-bold mt-1 mb-0">Accès POS</h3>
                </div>
                <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle fs-4">
                    <i class="bi bi-cart-check"></i>
                </div>
            </div>
            <a href="/pos" class="btn btn-outline-primary btn-sm mt-3 w-100">Ouvrir la caisse</a>
        </div>
    </div>

    {% if is_granted('ROLE_ADMIN') %}
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase">Carte & Menus</span>
                    <h3 class="fw-bold mt-1 mb-0">10 Plats</h3>
                </div>
                <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-circle fs-4">
                    <i class="bi bi-journal-text"></i>
                </div>
            </div>
            <a href="/admin/products" class="btn btn-outline-warning btn-sm mt-3 w-100">Gérer la carte</a>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase">Alertes Stock</span>
                    <h3 class="fw-bold mt-1 mb-0 text-danger">1 Alerte</h3>
                </div>
                <div class="bg-danger bg-opacity-10 text-danger p-3 rounded-circle fs-4">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
            </div>
            <a href="/admin/stocks" class="btn btn-outline-danger btn-sm mt-3 w-100">Voir les stocks</a>
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}